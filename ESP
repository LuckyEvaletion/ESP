local esp = {}

Create = function(...)
		local args = {...}
		if type(args) ~= "table" then return end
		local new = Instance.new(args[1])
		local Children = {}
		
		if type(args[2]) == "table" then
			SetProps(new, args[2])
			SetChildren(new, args[3])
			Children = args[3] or {}
		elseif typeof(args[2]) == "Instance" then
			new.Parent = args[2]
			SetProps(new, args[3])
			SetChildren(new, args[4])
			Children = args[4] or {}
		end
		return new
end
local function esp:AddESP(args)
local Target = args.Target or args.Child
local Title = args.Title or args.Name or "Title"
local TextSize = args.TextSize or args.FontSize or 14
local Color = args.Color or Color3.fromRGB(0,255,25)
local Distance = args.Distance or false
local Rainbow = args.Rainbow or false
local Tracer = args.Tracer or false
local Put = args.Put or "esp by wearid"

local bill = Create("BillboardGui", CoreGui, {
	Name = Put,
    AlwaysOnTop = true,
    Size = UDim2.new(0,400,0,100),
    Active = true,
    Adornee = Target,
    Parent = Target,
}, {
	local text = Create("TextLabel", bill, {
		BackgroundTransparency = 1,
        BackgroundColor3 = Color3.new(0,0,0),
        TextColor3 = Color,
        FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold),
        TextSize = TextSize,
        TextTransparency = 0,
        Visible = true,
        Text = Title,
        Size = UDim2.new(1,0,1,0),
	})
    Create("UIStroke", text, {
        Thickness = 1,
        Color = Color3.new(0,0,0),
        Transparency = 0,
   })
})




