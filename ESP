local LocalPlayer = game:GetService("Players").LocalPlayer
local CoreGui = game:GetService("CoreGui")

local function Create(...)
    local args = {...}
    local new = Instance.new(args[1])
    local props, children = args[2], args[3]

    if typeof(props) == "Instance" then
        new.Parent = props
        props, children = args[3], args[4]
    end

    for i,v in pairs(props or {}) do
        new[i] = v
    end

    for _,v in pairs(children or {}) do
        v.Parent = new
    end

    return new
end

local esp = {}

function esp:AddESP(args)
    local Target = args.Target or args.Child
    if not Target then return end

    local Title = args.Title or args.Name or Target.Name
    local TextSize = args.TextSize or args.FontSize or 14
    local Color = args.Color or Color3.fromRGB(0,255,25)
    local Distance = args.Distance or false
    local Rainbow = args.Rainbow or false
    local TracerEnabled = args.Tracer or false

    local gradient = Create("UIGradient", nil, {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color),
            ColorSequenceKeypoint.new(1, Color3.new(1,1,1))
        })
    })

    local bill = Create("BillboardGui", CoreGui, {
        Name = args.Put or "ESP",
        AlwaysOnTop = true,
        Size = UDim2.fromOffset(400,100),
        Adornee = Target
    }, {
        Create("TextLabel", nil, {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1,1),
            Text = Title,
            TextSize = TextSize,
            TextColor3 = Color,
            Font = Enum.Font.GothamBold
        }, {
            Create("UIStroke", nil, {
                Thickness = 1,
                Color = Color3.new(0,0,0)
            }, {
                gradient
            })
        })
    })

    local text = bill:FindFirstChildWhichIsA("TextLabel")

    local highlight = Create("Highlight", CoreGui, {
        Adornee = Target,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillColor = Color,
        OutlineColor = Color,
        FillTransparency = 1,
        OutlineTransparency = 0
    })

    local tracer

    if TracerEnabled then
        tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Transparency = 1
        tracer.Color = Color
    end

    task.spawn(function()
        repeat
            local root = LocalPlayer.Character
                and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            local pos = Target:GetPivot().Position

            gradient.Rotation = (gradient.Rotation + 1) % 360

            if Distance and root then
                text.Text = Title .. "\n(" ..
                    math.floor((root.Position - pos).Magnitude) .. "m)"
            else
                text.Text = Title
            end

            if Rainbow then
                Color = Color3.fromHSV((tick() % 5) / 5,1,1)
            end

            text.TextColor3 = Color
            highlight.FillColor = Color
            highlight.OutlineColor = Color

            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color),
                ColorSequenceKeypoint.new(1, Color3.new(1,1,1))
            })

            if tracer then
                local Camera = workspace.CurrentCamera
                local Screen, Visible =
                    Camera:WorldToViewportPoint(pos)

                tracer.From = Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y
                )

                tracer.To = Vector2.new(Screen.X, Screen.Y)
                tracer.Color = Color
                tracer.Visible = Visible
            end

            task.wait()
        until not Target.Parent

        bill:Destroy()
        highlight:Destroy()

        if tracer then
            tracer:Remove()
        end
    end)

    return bill
end
return esp
